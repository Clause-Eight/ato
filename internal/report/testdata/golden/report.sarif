{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ATO",
          "version": "test",
          "informationUri": "https://github.com/Clause-Eight/ato",
          "rules": [
            {
              "id": "card",
              "name": "PaymentCardNumber",
              "shortDescription": {
                "text": "Payment card number"
              },
              "fullDescription": {
                "text": "Payment card number found in the repository. Personal data in code, fixtures and logs is easy to copy and hard to delete."
              },
              "help": {
                "text": "Replace the value with synthetic test data or a reference, and remove it from history if it is real."
              },
              "properties": {
                "tags": [
                  "privacy",
                  "gdpr",
                  "eu"
                ]
              }
            },
            {
              "id": "card-security-code",
              "name": "CardSecurityCodeCVV/CVC",
              "shortDescription": {
                "text": "Card security code (CVV/CVC)"
              },
              "fullDescription": {
                "text": "Card security code (CVV/CVC) found in the repository. Personal data in code, fixtures and logs is easy to copy and hard to delete."
              },
              "help": {
                "text": "Replace the value with synthetic test data or a reference, and remove it from history if it is real."
              },
              "properties": {
                "tags": [
                  "privacy",
                  "gdpr",
                  "eu"
                ]
              }
            },
            {
              "id": "ee-isikukood",
              "name": "EstonianPersonalCodeIsikukood",
              "shortDescription": {
                "text": "Estonian personal code (isikukood)"
              },
              "fullDescription": {
                "text": "Estonian personal code (isikukood) found in the repository. Personal data in code, fixtures and logs is easy to copy and hard to delete."
              },
              "help": {
                "text": "Replace the value with synthetic test data or a reference, and remove it from history if it is real."
              },
              "properties": {
                "tags": [
                  "privacy",
                  "gdpr",
                  "ee"
                ]
              }
            },
            {
              "id": "log-sink/log",
              "name": "PersonalDataWrittenToALog",
              "shortDescription": {
                "text": "Personal data written to a log"
              },
              "fullDescription": {
                "text": "Personal data written to a log. Personal data in logs, error reports and analytics is copied to systems with wider access and longer retention than the data itself."
              },
              "help": {
                "text": "Log an identifier or a masked value instead, or remove the field from what is sent."
              },
              "properties": {
                "tags": [
                  "privacy",
                  "gdpr",
                  "logging",
                  "log"
                ]
              }
            },
            {
              "id": "ro-cnp",
              "name": "RomanianPersonalNumberCNP",
              "shortDescription": {
                "text": "Romanian personal number (CNP)"
              },
              "fullDescription": {
                "text": "Romanian personal number (CNP) found in the repository. Personal data in code, fixtures and logs is easy to copy and hard to delete."
              },
              "help": {
                "text": "Replace the value with synthetic test data or a reference, and remove it from history if it is real."
              },
              "properties": {
                "tags": [
                  "privacy",
                  "gdpr",
                  "ro"
                ]
              }
            },
            {
              "id": "special-category/criminal-convictions-and-offences",
              "name": "FieldHoldingCriminalConvictionsOrOffencesGDPRArt.10",
              "shortDescription": {
                "text": "Field holding criminal convictions or offences (GDPR Art. 10)"
              },
              "fullDescription": {
                "text": "Field holding criminal convictions or offences (GDPR Art. 10). Data relating to criminal convictions and offences may be processed only under the control of official authority or where Union or Member State law authorises it."
              },
              "help": {
                "text": "Record the law that authorises processing this field and its safeguards, or remove it if the data is not needed."
              },
              "properties": {
                "tags": [
                  "privacy",
                  "gdpr",
                  "gdpr-art-10",
                  "criminal-convictions-and-offences"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "card",
          "level": "error",
          "message": {
            "text": "Payment card number ••••••••••••0006 (high confidence): brand prefix, length and Luhn check are valid; the word \"card\" is nearby"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/config.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 3,
                  "startColumn": 9
                }
              }
            }
          ],
          "partialFingerprints": {
            "ato/v1": "0123456789abcdef0123456789abcdef",
            "piiEu/v1": "0123456789abcdef0123456789abcdef"
          },
          "properties": {
            "confidence": "high",
            "sample": false,
            "testPath": false
          }
        },
        {
          "ruleId": "ro-cnp",
          "level": "note",
          "message": {
            "text": "Romanian personal number (CNP) ••••••••••••• (low confidence): date, county code and check digit are valid; in a test, fixture or example path"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "tests/fixtures/users.json",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 12
                }
              }
            }
          ],
          "partialFingerprints": {
            "ato/v1": "fedcba9876543210fedcba9876543210",
            "piiEu/v1": "fedcba9876543210fedcba9876543210"
          },
          "properties": {
            "confidence": "low",
            "sample": false,
            "testPath": true
          }
        },
        {
          "ruleId": "ro-cnp",
          "level": "warning",
          "message": {
            "text": "Romanian personal number (CNP) ••••••••••••• in column \"cnp\" (medium confidence): date, county code and check digit are valid; the word \"cnp\" is nearby"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "exports/users.csv.gz!/users.csv",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2,
                  "startColumn": 7
                }
              }
            }
          ],
          "partialFingerprints": {
            "ato/v1": "00ff00ff00ff00ff00ff00ff00ff00ff",
            "piiEu/v1": "00ff00ff00ff00ff00ff00ff00ff00ff"
          },
          "properties": {
            "columnName": "cnp",
            "confidence": "medium",
            "sample": false,
            "testPath": false
          }
        },
        {
          "ruleId": "ee-isikukood",
          "level": "warning",
          "message": {
            "text": "Possibly Estonian personal code (isikukood) or Lithuanian personal code (asmens kodas) ••••••••••• (medium confidence): birth date, century digit and check digit are valid; the whole of a quoted value; just as valid as Lithuanian personal code (asmens kodas); nothing nearby says which"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/seed.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 31
                }
              }
            }
          ],
          "partialFingerprints": {
            "ato/v1": "0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f",
            "piiEu/v1": "0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f"
          },
          "properties": {
            "confidence": "medium",
            "sample": false,
            "testPath": false
          }
        },
        {
          "ruleId": "card-security-code",
          "level": "error",
          "message": {
            "text": "Card security code (CVV/CVC) ••• (high confidence): three or four digits under a card security code label, next to a valid card number; the word \"cvv\" is nearby"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/config.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 5,
                  "startColumn": 8
                }
              }
            }
          ],
          "partialFingerprints": {
            "ato/v1": "a0a1a2a3a4a5a6a7a8a9aaabacadaeaf",
            "piiEu/v1": "a0a1a2a3a4a5a6a7a8a9aaabacadaeaf"
          },
          "properties": {
            "confidence": "high",
            "sample": false,
            "testPath": false
          }
        },
        {
          "ruleId": "special-category/criminal-convictions-and-offences",
          "level": "warning",
          "message": {
            "text": "Field holding criminal convictions or offences (GDPR Art. 10) applicants.criminal_record (medium confidence): the name contains \"criminal record\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "db/002.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 6,
                  "startColumn": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "ato/v1": "b0b1b2b3b4b5b6b7b8b9babbbcbdbebf",
            "piiEu/v1": "b0b1b2b3b4b5b6b7b8b9babbbcbdbebf"
          },
          "properties": {
            "confidence": "medium",
            "sample": false,
            "testPath": false
          }
        },
        {
          "ruleId": "log-sink/log",
          "level": "warning",
          "message": {
            "text": "Personal data written to a log user.Email (medium confidence): the name contains \"email\"; passed to log.Printf, which writes to a log"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/handler.go",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 30
                }
              }
            }
          ],
          "partialFingerprints": {
            "ato/v1": "ffeeddccbbaa99887766554433221100",
            "piiEu/v1": "ffeeddccbbaa99887766554433221100"
          },
          "properties": {
            "confidence": "medium",
            "sample": false,
            "testPath": false
          }
        }
      ]
    }
  ]
}
