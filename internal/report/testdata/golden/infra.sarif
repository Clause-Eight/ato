{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pii-eu",
          "version": "test",
          "informationUri": "https://github.com/Clause-Eight/pii-eu",
          "rules": [
            {
              "id": "tf-non-eea-region",
              "name": "DataStoreOutsideTheEEA",
              "shortDescription": {
                "text": "Data store outside the EEA"
              },
              "fullDescription": {
                "text": "Data store outside the EEA, declared in Terraform. Personal data at rest needs encryption, a retention limit and EU residency or a documented transfer (GDPR Chapter V)."
              },
              "help": {
                "text": "Move the store to a region in the EEA, or document the transfer mechanism (adequacy decision, SCCs) for this region."
              },
              "properties": {
                "tags": [
                  "privacy",
                  "gdpr",
                  "terraform",
                  "infrastructure"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "tf-non-eea-region",
          "level": "error",
          "message": {
            "text": "Data store outside the EEA aws_s3_bucket.exports (high confidence): region us-east-1 is outside the EEA; linked to personal data: tagged data_classification with \"pii\""
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "infra/main.tf",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 1
                }
              }
            }
          ],
          "partialFingerprints": {
            "piiEu/v1": "ffeeddccbbaa99887766554433221100"
          },
          "properties": {
            "confidence": "high",
            "sample": false,
            "testPath": false
          }
        }
      ]
    }
  ]
}
