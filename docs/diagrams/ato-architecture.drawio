<mxCell id="fix-l" value="&lt;b style=&quot;color:#1C1B19;font-size:12px&quot;&gt;Replace test data&lt;/b&gt;&lt;br&gt;runs a scan, then rewrites&lt;br&gt;test paths&lt;br&gt;&lt;span style=&quot;font-family:SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;color:#6A645B&quot;&gt;ato fix&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#57534C;spacing=0;" vertex="1" parent="1"><mxGeometry x="825" y="1045" width="150" height="70" as="geometry" /></mxCell>
<mxCell id="synth" value="" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;fillColor=#FFFDF8;strokeColor=#8C8475;strokeWidth=1.2;html=1;" vertex="1" parent="1"><mxGeometry x="1015" y="984" width="50" height="56" as="geometry" /></mxCell>
<mxCell id="synth-l" value="&lt;b style=&quot;color:#1C1B19;font-size:12px&quot;&gt;Generators&lt;/b&gt;&lt;br&gt;valid, made-up values&lt;br&gt;with a synthetic mark&lt;br&gt;&lt;span style=&quot;font-family:SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;color:#6A645B&quot;&gt;synth&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#57534C;spacing=0;" vertex="1" parent="1"><mxGeometry x="970" y="1045" width="140" height="70" as="geometry" /></mxCell>
<mxCell id="arch-n39" value="1" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="119" y="195" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n40" value="2" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="949" y="533" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n41" value="3" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1309" y="553" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n42" value="4" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1439" y="553" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n43" value="5" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1569" y="553" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n44" value="6" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1699" y="553" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n45" value="7" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1829" y="553" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n46" value="8" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1959" y="553" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n47" value="9" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2319" y="577" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="arch-n48" value="10" style="ellipse;html=1;fillColor=#2340B0;strokeColor=#F3EFE6;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2789" y="553" width="26" height="26" as="geometry" /></mxCell>
<mxCell id="steps" value="&lt;b style=&quot;font-size:14px&quot;&gt;Follow the numbers: one &lt;span style=&quot;font-family:SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;color:#6A645B;font-size:12px&quot;&gt;ato scan .&lt;/span&gt;&lt;/b&gt;&lt;table style=&quot;margin-top:8px;font-size:12px;color:#1C1B19&quot;&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;width:50%&quot;&gt;&lt;table&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;1&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;You run &lt;b&gt;ato scan&lt;/b&gt; on a laptop, in a pre-commit hook or in CI. The CLI reads .ato.toml, checks the license offline and builds one request.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;2&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;&lt;b&gt;Walk&lt;/b&gt; lists the files. It uses git's own list so .gitignore applies, with every git setting that could run code turned off (ADR 7). Archives and image layers open in place.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;3&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;&lt;b&gt;Workers&lt;/b&gt;, one per CPU core, each take one file at a time.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;4&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;Each file is &lt;b&gt;routed&lt;/b&gt; by its first 8 KB: binary metadata, Terraform, data files by column, schemas and models, or plain text.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;5&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;Each line is checked for &lt;b&gt;candidates&lt;/b&gt;: a quick prefilter, then each detector's pattern. URL-encoded and base64 text is decoded and checked too.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top&quot;&gt;&lt;table&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;6&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;Only values that pass the identifier's own rules (&lt;b&gt;check digits, dates, lengths&lt;/b&gt;) go on. Lookalikes stop here.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;7&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;&lt;b&gt;Confidence&lt;/b&gt; rises for a nearby keyword or the usual format and drops in test paths. The value is &lt;b&gt;masked&lt;/b&gt; here and never shown again.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;8&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;&lt;b&gt;Collect&lt;/b&gt; merges every worker's results, with the fields, stores and recipients from the structure readers.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;9&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;The CLI drops findings on &lt;b&gt;ato:ignore&lt;/b&gt; lines, in the &lt;b&gt;baseline&lt;/b&gt;, and under the &lt;b&gt;minimum confidence&lt;/b&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;vertical-align:top;padding:3px 10px 5px 0&quot;&gt;&lt;span style=&quot;display:inline-block;width:20px;height:20px;line-height:20px;border-radius:10px;background:#2340B0;color:#fff;text-align:center;font-weight:bold&quot;&gt;10&lt;/span&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:top;padding:3px 18px 5px 0&quot;&gt;The &lt;b&gt;report&lt;/b&gt; is written and the &lt;b&gt;exit code&lt;/b&gt; set: 1 if anything was found, 3 if a file was not read in full, otherwise 0.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=16;fillColor=#FFFDF8;strokeColor=#DED7CA;rounded=1;arcSize=2;fontColor=#1C1B19;" vertex="1" parent="1"><mxGeometry x="2010" y="110" width="1300" height="262" as="geometry" /></mxCell>
<mxCell id="legend" value="&lt;b style=&quot;font-size:13px&quot;&gt;Key&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;━━&lt;/span&gt; the path of one scan &amp;nbsp; &lt;span style=&quot;color:#8A847A&quot;&gt;──&lt;/span&gt; side path &amp;nbsp; &lt;span style=&quot;color:#8A847A&quot;&gt;╌╌&lt;/span&gt; settings or result&lt;br&gt;Blue: runs on every scan · yellow: gates in the CLI · grey: optional or other commands&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Guarantees in the code&lt;/b&gt;&lt;br&gt;No network calls; the license is checked offline (ADR 15)&lt;br&gt;Values are masked at step 7; reports, baselines and SARIF never hold them&lt;br&gt;A scanned repo's .git/config cannot run commands (ADR 7)&lt;br&gt;A file not read in full means exit 3, never a silent pass (ADR 8)&lt;br&gt;Binary readers treat input as hostile and fail closed (ADR 13)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:13px&quot;&gt;Defaults&lt;/b&gt;&lt;br&gt;files up to 5 MiB · 100,000 rows per data file&lt;br&gt;archives up to 4 GiB, 1M entries, 3 levels deep" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;spacing=16;fillColor=#FFFDF8;strokeColor=#DED7CA;rounded=1;arcSize=3;fontColor=#1C1B19;" vertex="1" parent="1"><mxGeometry x="2790" y="830" width="530" height="330" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pipe" name="2 · Scan pipeline"><mxGraphModel dx="2800" dy="1600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pipe-bg" value="" style="rounded=0;html=1;fillColor=#F3EFE6;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2240" height="1500" as="geometry" /></mxCell>
<mxCell id="pipe-t1" value="&lt;span style=&quot;background:#DCE3FA;border:1px solid #2340B0;padding:1px 8px&quot;&gt;core logic&lt;/span&gt; &amp;nbsp; &lt;span style=&quot;background:#FBEFC0;border:1px solid #C9A93E;padding:1px 8px&quot;&gt;decision or gate&lt;/span&gt; &amp;nbsp; &lt;span style=&quot;background:#FBE3E5;border:1px solid #D7263D;padding:1px 8px&quot;&gt;not read: exit 3&lt;/span&gt; &amp;nbsp; &lt;span style=&quot;background:#D8F8F1;border:1px dashed #076357;padding:1px 8px;color:#076357&quot;&gt;worked example: one line traced through every step&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1C1B19;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="98" width="1800" height="22" as="geometry" /></mxCell>
<mxCell id="pipe-sn2" value="1" style="ellipse;html=1;fillColor=#2340B0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="pipe-t3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Pick files&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#57534C&quot;&gt;which files are read, and how safely · internal/walk&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1C1B19;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="144" width="1900" height="26" as="geometry" /></mxCell>
<mxCell id="pipe-r4" value="" style="line;html=1;strokeColor=#DED7CA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="174" width="2160" height="4" as="geometry" /></mxCell>
<mxCell id="pipe-sn11" value="2" style="ellipse;html=1;fillColor=#2340B0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="pipe-t12" value="&lt;b style=&quot;font-size:15px&quot;&gt;Route each file&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#57534C&quot;&gt;one worker per CPU core, one file per job; the first 8 KB decide the route · engine.scanContent&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1C1B19;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="354" width="1900" height="26" as="geometry" /></mxCell>
<mxCell id="pipe-r13" value="" style="line;html=1;strokeColor=#DED7CA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="384" width="2160" height="4" as="geometry" /></mxCell>
<mxCell id="pipe-sn37" value="3" style="ellipse;html=1;fillColor=#2340B0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="pipe-t38" value="&lt;b style=&quot;font-size:15px&quot;&gt;One line becomes one finding&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#57534C&quot;&gt;every text line goes through these eight steps in order · engine/line.go and the detector registry&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1C1B19;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="754" width="1900" height="26" as="geometry" /></mxCell>
<mxCell id="pipe-r39" value="" style="line;html=1;strokeColor=#DED7CA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="784" width="2160" height="4" as="geometry" /></mxCell>
<mxCell id="pipe-t40" value="&lt;span style=&quot;color:#076357&quot;&gt;&lt;b&gt;Worked example&lt;/b&gt;, the README's sample: line 4 of &lt;span style=&quot;font-family:SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;color:#6A645B;font-size:11px;color:#076357&quot;&gt;tests/fixtures/users.json&lt;/span&gt; is &lt;span style=&quot;font-family:SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;color:#6A645B;font-size:11px;color:#076357&quot;&gt;&quot;cnp&quot;: &quot;&amp;lt;13-digit CNP&amp;gt;&quot;&lt;/span&gt;, and line 6 has an &lt;span style=&quot;font-family:SFMono-Regular,Menlo,Consolas,monospace;font-size:10px;color:#6A645B;font-size:11px;color:#076357&quot;&gt;order_id&lt;/span&gt; with the same 13-digit shape.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1C1B19;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="2100" height="20" as="geometry" /></mxCell>
<mxCell id="pipe-sn64" value="4" style="ellipse;html=1;fillColor=#2340B0;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="pipe-t65" value="&lt;b style=&quot;font-size:15px&quot;&gt;Decide and report&lt;/b&gt; &amp;nbsp;&lt;span style=&quot;color:#57534C&quot;&gt;results are merged, then the CLI filters them, writes the report and picks the exit code · engine.fold, cli.runScan&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#1C1B19;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="1104" width="1900" height="26" as="geometry" /></mxCell>
<mxCell id="pipe-r66" value="" style="line;html=1;strokeColor=#DED7CA;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="40" y="1134" width="2160" height="4" as="geometry" /></mxCell>
<mxCell id="pipe-t86" value="&lt;b&gt;ATO · scan pipeline, step by step&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=22;fontColor=#1C1B19;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="32" width="1600" height="30" as="geometry" /></mxCell>
<mxCell id="pipe-t87" value="How files are chosen and routed, how one line becomes a masked finding, and how the CLI decides what to report · one fixture line traced through every step" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13.5;fontColor=#57534C;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1700" height="24" as="geometry" /></mxCell>
<mxCell id="pipe-e26" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b14" target="pipe-d15"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e27" value="yes" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe-d15" target="pipe-b20"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e28" value="no" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-d15" target="pipe-d16"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e29" value="yes" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe-d16" target="pipe-b21"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e30" value="no" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-d16" target="pipe-d17"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e31" value="yes" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe-d17" target="pipe-b22"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e32" value="no" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-d17" target="pipe-d18"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e33" value="yes" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe-d18" target="pipe-b23"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e34" value="no" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-d18" target="pipe-d19"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e35" value="yes" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pipe-d19" target="pipe-b24"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e36" value="no" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-d19" target="pipe-b25"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e44" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b41" target="pipe-b43"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e47" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b43" target="pipe-b46"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e50" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b46" target="pipe-b49"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e53" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b49" target="pipe-b52"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e56" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b52" target="pipe-b55"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e59" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b55" target="pipe-b58"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e62" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b58" target="pipe-b61"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e70" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b67" target="pipe-b69"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e73" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b69" target="pipe-b72"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e76" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b72" target="pipe-b75"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e79" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b75" target="pipe-b78"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-e82" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;endSize=5;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#57534C;labelBackgroundColor=#F3EFE6;" edge="1" parent="1" source="pipe-b78" target="pipe-x81"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
<mxCell id="pipe-b5" value="&lt;b&gt;Git's file list&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;In a git work tree, git ls-files, so .gitignore applies exactly as git applies it. Settings that run commands (fsmonitor, hooks, pager, external diff, credential helper) are forced off (ADR 7). Without git: a plain directory walk.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#DCE3FA;strokeColor=#2340B0;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="330" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-b6" value="&lt;b&gt;Staged changes (--staged)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;For pre-commit: the staged file names, and their content read from the index with git cat-file. No filters or text conversion run.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="280" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-b7" value="&lt;b&gt;Archives&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;tar, .gz and .zip are opened in place. Caps: 4 GiB, 1M entries, 3 levels deep. Over a cap means not read in full.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="710" y="190" width="260" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-b8" value="&lt;b&gt;Container images (--image)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;A docker save tar. Each layer is scanned in parallel, plus the image config (environment, labels, history).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="280" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-b9" value="&lt;b&gt;A stream (ato scan -)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Piped text, such as a log tail, goes straight to the line scanner. No file list, no baseline.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1310" y="190" width="250" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-b10" value="&lt;b&gt;One request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Everything later steps need: detectors on by config and --countries, minimum confidence, row limit, which extra readers to run.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#ECE6DA;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1590" y="190" width="300" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-b14" value="&lt;b&gt;Workers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;runtime.NumCPU() goroutines take file numbers from a channel. Each returns its results; they are merged in order at the end.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#DCE3FA;strokeColor=#2340B0;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="240" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-d15" value="known binary&lt;br&gt;format?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1C1B19;fillColor=#FBEFC0;strokeColor=#C9A93E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="330" y="422" width="170" height="96" as="geometry" /></mxCell>
<mxCell id="pipe-d16" value="other binary?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1C1B19;fillColor=#FBEFC0;strokeColor=#C9A93E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="630" y="422" width="170" height="96" as="geometry" /></mxCell>
<mxCell id="pipe-d17" value="Terraform?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1C1B19;fillColor=#FBEFC0;strokeColor=#C9A93E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="930" y="422" width="170" height="96" as="geometry" /></mxCell>
<mxCell id="pipe-d18" value="data file?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1C1B19;fillColor=#FBEFC0;strokeColor=#C9A93E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1230" y="422" width="170" height="96" as="geometry" /></mxCell>
<mxCell id="pipe-d19" value="schema, model,&lt;br&gt;deps or deletion code?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1C1B19;fillColor=#FBEFC0;strokeColor=#C9A93E;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="1530" y="422" width="170" height="96" as="geometry" /></mxCell>
<mxCell id="pipe-b20" value="&lt;b&gt;Read the metadata&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;&lt;i&gt;photo.jpg, contract.docx, report.pdf, db.dump&lt;/i&gt;&lt;br&gt;GPS in photos, document authors, PDF text, pg_dump tables. Hostile input, fail closed (ADR 13).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="310" y="575" width="210" height="136" as="geometry" /></mxCell>
<mxCell id="pipe-b21" value="&lt;b&gt;Skip&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;&lt;i&gt;logo.png, app.exe&lt;/i&gt;: skipped.&lt;br&gt;&lt;i&gt;sales.xlsx, data.sqlite, x.7z&lt;/i&gt;: formats that often hold personal data but are not opened, so marked not read: exit 3 (ADR 8).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FBE3E5;strokeColor=#D7263D;" vertex="1" parent="1"><mxGeometry x="610" y="575" width="210" height="136" as="geometry" /></mxCell>
<mxCell id="pipe-b22" value="&lt;b&gt;Stores and lines&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;&lt;i&gt;main.tf&lt;/i&gt;&lt;br&gt;Data stores with encryption, retention and region (no Terraform run, unknown is never guessed), plus the normal line scan.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="910" y="575" width="210" height="136" as="geometry" /></mxCell>
<mxCell id="pipe-b23" value="&lt;b&gt;By column&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;&lt;i&gt;users.csv, events.jsonl, dump.sql&lt;/i&gt;&lt;br&gt;Headers go to field-name checks; values are scanned with their column name. Over 100,000 rows: sampled, marked not read.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1210" y="575" width="210" height="136" as="geometry" /></mxCell>
<mxCell id="pipe-b24" value="&lt;b&gt;Whole file&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;&lt;i&gt;models.py, schema.prisma, package.json&lt;/i&gt;&lt;br&gt;Field names, third-party services and deletion paths, plus the normal line scan.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1510" y="575" width="210" height="136" as="geometry" /></mxCell>
<mxCell id="pipe-b25" value="&lt;b&gt;Line by line&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;&lt;i&gt;app.py, server.log, users.json&lt;/i&gt;&lt;br&gt;Everything else that is text. Logging calls are also checked for personal data.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#DCE3FA;strokeColor=#2340B0;" vertex="1" parent="1"><mxGeometry x="1830" y="422" width="250" height="124" as="geometry" /></mxCell>
<mxCell id="pipe-b41" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.1&lt;/span&gt;&amp;nbsp; &lt;b&gt;Prefilter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Skips detectors that cannot match this line: too few digits, a required word missing. Keeps scans fast as detectors are added.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="40" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr42" value="13 digits on the line: the CNP detector and others that need 13 digits stay; most are skipped." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="40" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b43" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.2&lt;/span&gt;&amp;nbsp; &lt;b&gt;Pattern&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Each remaining detector's pattern finds candidates. The characters around a candidate must not be letters or digits.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="310" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr45" value="The CNP pattern matches the 13-digit run. The quotes around it are clean edges." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="310" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b46" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.3&lt;/span&gt;&amp;nbsp; &lt;b&gt;Decode&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;The line is also read with URL escapes and whole base64 tokens (12 to 64 characters) decoded. A finding says which encoding it was in.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="580" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr48" value="Plain text: nothing to decode." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="580" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b49" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.4&lt;/span&gt;&amp;nbsp; &lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;The identifier's own rules: check digits, dates, lengths, region codes. Only valid values go on. A product barcode next to the word barcode is not a card.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#DCE3FA;strokeColor=#2340B0;" vertex="1" parent="1"><mxGeometry x="850" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr51" value="Date, county code and check digit are valid.&lt;br&gt;&lt;b style=&quot;color:#8E1B2A&quot;&gt;order_id: month 41 does not exist. Dropped.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="850" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b52" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.5&lt;/span&gt;&amp;nbsp; &lt;b&gt;Guards&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Some identifiers need a keyword nearby. Numbers inside UUIDs, millisecond timestamps and number tables are ignored.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1120" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr54" value="Not inside a UUID, a timestamp or a table of numbers." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="1120" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b55" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.6&lt;/span&gt;&amp;nbsp; &lt;b&gt;Confidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Starts at the detector's base. +1 for the usual format, +1 for a keyword on the line, the line before or the column (24 languages). −1 in test paths, −1 next to order or invoice. Published samples: low.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#DCE3FA;strokeColor=#2340B0;" vertex="1" parent="1"><mxGeometry x="1390" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr57" value="Base medium. +1 for the word cnp: high. −1 for the tests/ path: &lt;b&gt;medium&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="1390" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b58" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.7&lt;/span&gt;&amp;nbsp; &lt;b&gt;Overlaps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;The most confident match wins. A value valid for two detectors is reported once; the nearby name decides, or it says Possibly X or Y.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1660" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr60" value="No other detector accepts it: reported once." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="1660" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b61" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;3.8&lt;/span&gt;&amp;nbsp; &lt;b&gt;Mask&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;The value is masked here. Reports, baselines and SARIF never see it again (--show-values only prints to a terminal).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#DCE3FA;strokeColor=#2340B0;" vertex="1" parent="1"><mxGeometry x="1930" y="822" width="240" height="150" as="geometry" /></mxCell>
<mxCell id="pipe-tr63" value="Shown as ••••••••••••• from now on." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="1930" y="984" width="240" height="82" as="geometry" /></mxCell>
<mxCell id="pipe-b67" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;4.1&lt;/span&gt;&amp;nbsp; &lt;b&gt;Collect&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Merge every worker's results, count files, sort. Also gather fields, Terraform stores, third parties and deletion paths.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#DCE3FA;strokeColor=#2340B0;" vertex="1" parent="1"><mxGeometry x="40" y="1150" width="260" height="120" as="geometry" /></mxCell>
<mxCell id="pipe-tr68" value="1 finding in users.json." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="40" y="1282" width="260" height="60" as="geometry" /></mxCell>
<mxCell id="pipe-b69" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;4.2&lt;/span&gt;&amp;nbsp; &lt;b&gt;Ignore comments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Findings on a line with an ato:ignore comment are dropped and counted.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FBEFC0;strokeColor=#C9A93E;" vertex="1" parent="1"><mxGeometry x="340" y="1150" width="260" height="120" as="geometry" /></mxCell>
<mxCell id="pipe-tr71" value="No ato:ignore on line 4: kept." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="340" y="1282" width="260" height="60" as="geometry" /></mxCell>
<mxCell id="pipe-b72" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;4.3&lt;/span&gt;&amp;nbsp; &lt;b&gt;Baseline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;.ato-baseline.json holds fingerprints made from the detector, the path and the line with values replaced. Only new findings pass.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FBEFC0;strokeColor=#C9A93E;" vertex="1" parent="1"><mxGeometry x="640" y="1150" width="260" height="120" as="geometry" /></mxCell>
<mxCell id="pipe-tr74" value="Fingerprint not in the baseline: new, kept." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="640" y="1282" width="260" height="60" as="geometry" /></mxCell>
<mxCell id="pipe-b75" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;4.4&lt;/span&gt;&amp;nbsp; &lt;b&gt;Minimum confidence&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Default medium, or set per detector in .ato.toml. Low findings, such as published sample values, are hidden by default.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FBEFC0;strokeColor=#C9A93E;" vertex="1" parent="1"><mxGeometry x="940" y="1150" width="260" height="120" as="geometry" /></mxCell>
<mxCell id="pipe-tr77" value="medium ≥ medium: kept." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="940" y="1282" width="260" height="60" as="geometry" /></mxCell>
<mxCell id="pipe-b78" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;4.5&lt;/span&gt;&amp;nbsp; &lt;b&gt;Report&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Terminal, JSON, SARIF, GitHub annotations, GitLab Code Quality or HTML. Masked values only.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="1240" y="1150" width="260" height="120" as="geometry" /></mxCell>
<mxCell id="pipe-tr80" value="&lt;span style=&quot;font-family:Menlo,monospace;font-size:10px&quot;&gt;4:13 medium Romanian personal number (CNP) •••••••••••••&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="1240" y="1282" width="260" height="60" as="geometry" /></mxCell>
<mxCell id="pipe-x81" value="&lt;span style=&quot;color:#2340B0;font-weight:bold&quot;&gt;4.6&lt;/span&gt;&amp;nbsp; &lt;b&gt;Exit code&lt;/b&gt;&lt;br&gt;1 · findings (wins over 3)&lt;br&gt;3 · a file not read in full&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(--allow-partial keeps 0 or 1)&lt;br&gt;0 · nothing found, everything read&lt;br&gt;2 · usage or settings error" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FBEFC0;strokeColor=#C9A93E;strokeWidth=1.6;" vertex="1" parent="1"><mxGeometry x="1540" y="1150" width="260" height="132" as="geometry" /></mxCell>
<mxCell id="pipe-tr83" value="&lt;b&gt;Exit 1.&lt;/b&gt; In CI the step fails and the pull request shows the finding." style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontSize=11;fontColor=#076357;spacing=7;align=left;verticalAlign=top;strokeWidth=1;fillColor=#D8F8F1;strokeColor=#076357;dashed=1;dashPattern=3 3;" vertex="1" parent="1"><mxGeometry x="1540" y="1294" width="260" height="48" as="geometry" /></mxCell>
<mxCell id="pipe-o84" value="&lt;b&gt;ato inventory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Every personal-data field with its table, category, special category, file and line. CSV, JSON or HTML: a first draft of the Art. 30 record.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;dashed=1;" vertex="1" parent="1"><mxGeometry x="1880" y="1150" width="320" height="128" as="geometry" /></mxCell>
<mxCell id="pipe-o85" value="&lt;b&gt;ato map, ato map --diff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#57534C&quot;&gt;Per component: stores and categories, logs of personal data, third parties (EEA or not). --diff exits 1 when anything is new.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#FFFDF8;strokeColor=#8C8475;dashed=1;" vertex="1" parent="1"><mxGeometry x="1880" y="1300" width="320" height="128" as="geometry" /></mxCell>
<mxCell id="pipe-lic" value="&lt;b&gt;License, off the scan path&lt;/b&gt;&lt;br&gt;A signed token (Ed25519) in ATO_LICENSE or the user's config folder, checked offline. Valid until its end date plus 30 days. Without one ATO still scans and prints one line on stderr; output and exit codes are the same (ADR 15)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#ECE6DA;strokeColor=#8C8475;" vertex="1" parent="1"><mxGeometry x="40" y="1380" width="900" height="84" as="geometry" /></mxCell>
<mxCell id="pipe-fix" value="&lt;b&gt;ato fix&lt;/b&gt;&lt;br&gt;Runs the same scan, then rewrites values in test, fixture and example paths with made-up ones that pass the same detector, keep the format and country, and carry a synthetic mark, so later scans report them as low-confidence samples." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=11.5;fontColor=#1C1B19;spacing=9;align=left;verticalAlign=top;strokeWidth=1.2;fillColor=#D8F8F1;strokeColor=#076357;" vertex="1" parent="1"><mxGeometry x="970" y="1380" width="880" height="84" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>