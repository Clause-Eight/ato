{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clause-Eight/pii-eu/schemas/findings.schema.json",
  "title": "pii-eu findings report",
  "description": "Output of `pii-eu scan --format json`. Found values are never included; `masked` keeps at most the last few characters.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.2",
      "description": "1.2 added sink and data_category to findings and the sink kind; 1.1 added kind and special_category. Older reports are 1.2 reports without those fields."
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "findings",
        "files_scanned",
        "files_skipped",
        "unreadable"
      ],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          }
        },
        "ignored": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings left out by a `pii-eu:ignore <reason>` comment."
        },
        "baselined": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings left out because they are in the baseline."
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "detector",
          "label",
          "country",
          "path",
          "line",
          "column",
          "confidence",
          "masked",
          "reasons",
          "sample",
          "test_path",
          "fingerprint"
        ],
        "properties": {
          "kind": {
            "enum": [
              "value",
              "field",
              "sink"
            ],
            "description": "value: personal data found in text. field: a schema or model field whose name says it holds special-category data (GDPR Art. 9); masked then holds the field name. sink: a log, error-tracker or analytics call that is passed personal data; masked then holds the expression passed, never a value."
          },
          "special_category": {
            "enum": [
              "racial-or-ethnic-origin",
              "political-opinions",
              "religious-or-philosophical-beliefs",
              "trade-union-membership",
              "genetic",
              "biometric",
              "health",
              "sex-life-or-sexual-orientation"
            ],
            "description": "The GDPR Art. 9 category, for kind field, and for kind sink when the data is special-category data."
          },
          "sink": {
            "enum": [
              "log",
              "error-tracker",
              "analytics"
            ],
            "description": "Where the call sends the data, for kind sink."
          },
          "data_category": {
            "enum": [
              "name",
              "contact",
              "address",
              "government-identifier",
              "financial",
              "birth-date",
              "location",
              "online-identifier",
              "demographic",
              "special-category"
            ],
            "description": "The kind of personal data, for kind field and for kind sink when a field name says which. Left out for a whole request body or a user-like object."
          },
          "detector": {
            "type": "string",
            "description": "Detector name, as listed by `pii-eu detectors`."
          },
          "label": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO country code, or EU for identifiers used across countries."
          },
          "path": {
            "type": "string",
            "description": "Path relative to the scanned folder, with forward slashes."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "masked": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sample": {
            "type": "boolean",
            "description": "The value is a published example, such as a documentation IBAN or a test card."
          },
          "test_path": {
            "type": "boolean"
          },
          "fingerprint": {
            "type": "string",
            "description": "Stable ID derived from the detector, path and the line with values replaced; never from the value."
          }
        }
      }
    }
  },
  "$defs": {
    "skipped": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
