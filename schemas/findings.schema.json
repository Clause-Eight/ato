{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clause-Eight/pii-eu/schemas/findings.schema.json",
  "title": "pii-eu findings report",
  "description": "Output of `pii-eu scan --format json`. Found values are never included; `masked` keeps at most the last few characters.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.5",
      "description": "1.5 added column_name to findings and sampled and columns to the summary; 1.1 added kind and special_category to findings. Older reports are 1.5 reports without those fields."
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "findings",
        "files_scanned",
        "files_skipped",
        "unreadable"
      ],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          }
        },
        "ignored": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings left out by a `pii-eu:ignore <reason>` comment."
        },
        "baselined": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings left out because they are in the baseline."
        },
        "sampled": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          },
          "description": "Data files of which only the first rows were read (`--max-rows`, `max_rows`). Absent when none were sampled."
        },
        "columns": {
          "type": "array",
          "description": "Findings grouped by file and column, for findings that have a column_name, in order of first appearance. Counts follow the reported findings. Absent when no finding has a column.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "column_name",
              "findings",
              "detectors"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "column_name": {
                "type": "string"
              },
              "findings": {
                "type": "integer",
                "minimum": 1
              },
              "detectors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "detector",
                    "findings"
                  ],
                  "properties": {
                    "detector": {
                      "type": "string"
                    },
                    "findings": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "detector",
          "label",
          "country",
          "path",
          "line",
          "column",
          "confidence",
          "masked",
          "reasons",
          "sample",
          "test_path",
          "fingerprint"
        ],
        "properties": {
          "kind": {
            "enum": [
              "value",
              "field"
            ],
            "description": "value: personal data found in text. field: a schema or model field whose name says it holds special-category data (GDPR Art. 9); masked then holds the field name."
          },
          "special_category": {
            "enum": [
              "racial-or-ethnic-origin",
              "political-opinions",
              "religious-or-philosophical-beliefs",
              "trade-union-membership",
              "genetic",
              "biometric",
              "health",
              "sex-life-or-sexual-orientation"
            ],
            "description": "The GDPR Art. 9 category, for kind field."
          },
          "detector": {
            "type": "string",
            "description": "Detector name, as listed by `pii-eu detectors`."
          },
          "label": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO country code, or EU for identifiers used across countries."
          },
          "path": {
            "type": "string",
            "description": "Path relative to the scanned folder, with forward slashes. Inside an archive or image, `!/` separates the archive from the path within it, as in dump.tar.gz!/data/users.csv or image.tar!/<layer>/etc/app/config.yml."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "column_name": {
            "type": "string",
            "description": "The data column the value was found in: a CSV or TSV header (#N when the file has no header), a JSON Lines key path such as customer.cnp, or a SQL column. Absent for text without columns."
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "masked": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sample": {
            "type": "boolean",
            "description": "The value is a published example, such as a documentation IBAN or a test card."
          },
          "test_path": {
            "type": "boolean"
          },
          "fingerprint": {
            "type": "string",
            "description": "Stable ID derived from the detector, path and the line with values replaced; never from the value."
          }
        }
      }
    }
  },
  "$defs": {
    "skipped": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
