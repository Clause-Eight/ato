{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clause-Eight/pii-eu/schemas/findings.schema.json",
  "title": "pii-eu findings report",
  "description": "Output of `pii-eu scan --format json`. Found values are never included; `masked` keeps at most the last few characters.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.3",
      "description": "1.3 added kind infra and store, for data stores declared in Terraform; 1.1 added kind and special_category. Older reports are 1.3 reports without those fields."
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "findings",
        "files_scanned",
        "files_skipped",
        "unreadable"
      ],
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "files_skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          }
        },
        "unreadable": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skipped"
          }
        },
        "ignored": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings left out by a `pii-eu:ignore <reason>` comment."
        },
        "baselined": {
          "type": "integer",
          "minimum": 0,
          "description": "Findings left out because they are in the baseline."
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "detector",
          "label",
          "country",
          "path",
          "line",
          "column",
          "confidence",
          "masked",
          "reasons",
          "sample",
          "test_path",
          "fingerprint"
        ],
        "properties": {
          "kind": {
            "enum": [
              "value",
              "field",
              "infra"
            ],
            "description": "value: personal data found in text. field: a schema or model field whose name says it holds special-category data (GDPR Art. 9); masked then holds the field name. infra: a data store declared in Terraform without encryption, a retention limit or EU residency, or open to the public; masked then holds the resource address."
          },
          "special_category": {
            "enum": [
              "racial-or-ethnic-origin",
              "political-opinions",
              "religious-or-philosophical-beliefs",
              "trade-union-membership",
              "genetic",
              "biometric",
              "health",
              "sex-life-or-sexual-orientation"
            ],
            "description": "The GDPR Art. 9 category, for kind field."
          },
          "detector": {
            "type": "string",
            "description": "Detector name, as listed by `pii-eu detectors`."
          },
          "label": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "ISO country code, or EU for identifiers used across countries."
          },
          "path": {
            "type": "string",
            "description": "Path relative to the scanned folder, with forward slashes."
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "masked": {
            "type": "string"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sample": {
            "type": "boolean",
            "description": "The value is a published example, such as a documentation IBAN or a test card."
          },
          "test_path": {
            "type": "boolean"
          },
          "fingerprint": {
            "type": "string",
            "description": "Stable ID derived from the detector, path and the line with values replaced; never from the value."
          },
          "store": {
            "type": "object",
            "description": "The data store, for kind infra.",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "provider",
              "service",
              "regions",
              "personal_data"
            ],
            "properties": {
              "type": {
                "type": "string",
                "description": "Terraform resource type, such as aws_s3_bucket."
              },
              "name": {
                "type": "string",
                "description": "The resource's name in the code."
              },
              "provider": {
                "enum": [
                  "aws",
                  "google",
                  "azurerm"
                ]
              },
              "service": {
                "type": "string",
                "description": "Kind of store, such as database, object-storage, queue or log."
              },
              "regions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Regions read from the code; empty when they cannot be read."
              },
              "personal_data": {
                "type": "boolean",
                "description": "Linked to personal data by a classification tag or a matching table or model name."
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "skipped": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
