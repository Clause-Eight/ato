{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clause-Eight/pii-eu/schemas/map.schema.json",
  "title": "pii-eu data map",
  "description": "Output of `pii-eu map --format json`: per component, the stores of personal data, where personal data is logged and the third parties the code names. Field names and locations only, never values.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "categories",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "description": "1.1 added module_source on infrastructure entries; a 1.0 map is a 1.1 map without it."
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "place": {
      "type": "object",
      "required": [
        "path",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "name",
        "stores",
        "sinks",
        "recipients"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "stores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/store"
          }
        },
        "sinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sink"
          }
        },
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipient"
          }
        },
        "infrastructure": {
          "description": "Data stores declared in Terraform. Settings are yes, no or unknown, and absent when they do not apply.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/infra"
          }
        }
      }
    },
    "store": {
      "type": "object",
      "required": [
        "name",
        "categories",
        "special_categories",
        "fields"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "category",
              "path",
              "line"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "special_category": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "erasure": {
          "description": "Where the code can erase a person's data from this store (GDPR Art. 17). Absent when not assessed; empty when none was found.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/removal"
          }
        },
        "retention": {
          "description": "Where the code removes old data from this store: time-based deletes, TTLs, partition drops. Absent when not assessed; empty when none was found.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/removal"
          }
        }
      }
    },
    "sink": {
      "type": "object",
      "required": [
        "label",
        "category",
        "path",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recipient": {
      "type": "object",
      "required": [
        "name",
        "purpose",
        "established_in_eea",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "established_in_eea": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/place"
          }
        }
      }
    },
    "removal": {
      "type": "object",
      "required": [
        "how",
        "path",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "how": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "infra": {
      "type": "object",
      "required": [
        "address",
        "service",
        "regions",
        "personal_data",
        "path",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "in_eea": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "encrypted": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "retention": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "public": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "personal_data": {
          "type": "boolean"
        },
        "module_source": {
          "type": "string",
          "description": "For a module call (address module.<name>) that pii-eu does not read inside: the module's source. Its settings are unknown."
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
