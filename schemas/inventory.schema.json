{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Clause-Eight/ato/schemas/inventory.schema.json",
  "title": "ATO data inventory",
  "description": "Output of `ato inventory --format json`: fields declared in schemas and models that hold personal data, and the data stores declared in Terraform. Names and locations only, never values.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "files_scanned",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.1",
      "description": "2.1 added criminal-convictions-and-offences (GDPR Art. 10) to special_category; 2.0 renamed the tool from pii-eu to ato (tool.name is ato) and changed no field; 1.2 added the source formats typeorm, mongoose, doctrine, laravel, csv, tsv and jsonl, stores of type module with the module object, and unknown as a store's provider or service; 1.1 added stores. An older 1.x inventory is a 2.0 inventory without those."
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The command that wrote the file: ato from 2.0, pii-eu before."
        },
        "version": {
          "type": "string"
        }
      }
    },
    "files_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "container",
          "data_category",
          "matched",
          "source_format",
          "path",
          "line",
          "column"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "container": {
            "type": "string",
            "description": "Table, model, message or schema name; empty when unknown."
          },
          "data_category": {
            "enum": [
              "name",
              "contact",
              "address",
              "government-identifier",
              "financial",
              "birth-date",
              "location",
              "online-identifier",
              "demographic",
              "special-category"
            ]
          },
          "special_category": {
            "enum": [
              "racial-or-ethnic-origin",
              "political-opinions",
              "religious-or-philosophical-beliefs",
              "trade-union-membership",
              "genetic",
              "biometric",
              "health",
              "sex-life-or-sexual-orientation",
              "criminal-convictions-and-offences"
            ]
          },
          "matched": {
            "type": "string",
            "description": "The dictionary word that decided the category."
          },
          "source_format": {
            "enum": [
              "sql",
              "django",
              "sqlalchemy",
              "activerecord",
              "gorm",
              "jpa",
              "prisma",
              "protobuf",
              "openapi",
              "dbt",
              "typeorm",
              "mongoose",
              "doctrine",
              "laravel",
              "csv",
              "tsv",
              "jsonl"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "description": "Data stores declared in Terraform, read without running Terraform. unknown means the value depends on something the code does not show; not-applicable means the setting does not exist for that kind of store.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "name",
          "provider",
          "service",
          "names",
          "regions",
          "in_eea",
          "encrypted",
          "retention",
          "backup",
          "public",
          "personal_data",
          "path",
          "line"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Terraform resource type, or module for a module call that is not read inside."
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "aws",
              "google",
              "azurerm",
              "unknown"
            ],
            "description": "unknown only for a module call whose provider the source and the folder do not show."
          },
          "service": {
            "enum": [
              "database",
              "warehouse",
              "key-value",
              "object-storage",
              "log",
              "queue",
              "topic",
              "stream",
              "cache",
              "search",
              "block-storage",
              "file-storage",
              "unknown"
            ],
            "description": "unknown only for a module call whose arguments look like store settings but whose source does not say what it creates."
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names in the cloud (bucket, table, database) as far as they are written out; parts from variables are left out."
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "in_eea": {
            "enum": [
              "yes",
              "no",
              "unknown",
              "not-applicable"
            ],
            "description": "Whether every region is in the European Economic Area."
          },
          "adequacy": {
            "type": "string",
            "description": "Country with an EU adequacy decision, when every region outside the EEA has one."
          },
          "encrypted": {
            "enum": [
              "yes",
              "no",
              "unknown",
              "not-applicable"
            ],
            "description": "Encryption at rest."
          },
          "retention": {
            "enum": [
              "yes",
              "no",
              "unknown",
              "not-applicable"
            ],
            "description": "Whether data expires: a lifecycle rule, retention period or TTL."
          },
          "backup": {
            "enum": [
              "yes",
              "no",
              "unknown",
              "not-applicable"
            ],
            "description": "Versioning, point-in-time recovery or automated backups."
          },
          "public": {
            "enum": [
              "yes",
              "no",
              "unknown",
              "not-applicable"
            ],
            "description": "Open to the public: a public grant, ACL or network endpoint."
          },
          "personal_data": {
            "type": "boolean"
          },
          "personal_data_reason": {
            "type": "string"
          },
          "module": {
            "type": "object",
            "description": "For type module: a module call that may create a store ATO does not read inside (a registry or git module, or a local folder that was not scanned). Every setting is unknown.",
            "additionalProperties": false,
            "required": [
              "source",
              "settings"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "settings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments of the call that look like store settings, such as storage_encrypted or retention_in_days, by name."
              }
            }
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
